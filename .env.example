# Local FastAPI API root. For production use your deployed HTTPS API URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1
# Example: https://api.your-domain.com/api/v1

# Set these to your official public profiles before production deployment.
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/
NEXT_PUBLIC_WHATSAPP_URL=https://www.whatsapp.com/

# Official support inbox used by the contact form (optional until configured).
NEXT_PUBLIC_SUPPORT_EMAIL=
